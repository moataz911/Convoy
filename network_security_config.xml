
<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- السماح بجميع اتصالات النص الواضح (Cleartext) بشكل افتراضي لجميع النطاقات -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
